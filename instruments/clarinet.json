{
  "id": "clarinet",
  "name": "Clarinet (B♭ Boehm, 17-key)",
  "family": "single-reed",
  "transposing": true,
  "note": "Front view, facing the instrument (same as the saxophone): left-hand pinky keys on the right at the joint, right-hand pinky keys bottom-left, trill keys on the left. Thumb hole and register key sit in their own column on the far left.",
  "viewBox": [0, 0, 92, 240],
  "defaults": {
    "circle": { "r": 9 },
    "oval": { "rx": 6.5, "ry": 3.8 },
    "pill": { "w": 12, "h": 5.5, "rad": 2.75 },
    "plate": { "w": 8, "h": 9 }
  },
  "panels": [{ "id": "front" }],
  "guides": [{ "id": "hand-divider", "x1": 34, "y1": 121, "x2": 54, "y2": 121 }],

  "clusters": [
    {
      "id": "trill",
      "label": "Trill keys",
      "note": "Stacked tabs on the left at the joint, pressed by the side of the right first finger.",
      "anchor": [26, 102],
      "flow": { "axis": "y", "pitch": 6.5 },
      "defaults": { "shape": "plate", "w": 9, "h": 5.8, "radii": [2.9, 1.2, 1.2, 2.9] }
    },
    {
      "id": "lh-table",
      "label": "LH pinky keys",
      "note": "Right of the stack at the joint: F/C as a flat oval on top, E/B and F♯/C♯ as tall keys below. A♭/E♭ (full Boehm only) is hidden by default.",
      "anchor": [61, 118]
    },
    {
      "id": "rh-table",
      "label": "RH pinky keys",
      "note": "Bottom-left of the stack: three lobes pointing left, each turning down into a stem. A♭/E♭ on top, E/B, then F/C. F♯/C♯ is hidden by default.",
      "anchor": [25, 211],
      "defaults": { "shape": "hook", "w": 18, "h": 8, "stemW": 3.2 }
    }
  ],

  "variants": {
    "pinky-tables": {
      "clusters": {
        "lh-table": { "anchor": [18, 116], "rotate": 4, "defaults": { "shape": "plate", "w": 10.5, "h": 11.5 } },
        "rh-table": { "anchor": [69, 204], "rotate": -4, "defaults": { "shape": "plate", "w": 10.5, "h": 11.5 } }
      },
      "keys": {
        "lh-fs-cs": { "shape": "plate", "dx": -5.9, "dy": 0, "w": null, "h": null, "radii": [5, 2.5, 2.5, 2.5] },
        "lh-ab-eb": { "default": "open", "dx": 5.9, "dy": 0, "w": null, "h": null, "radii": [2.5, 5, 2.5, 2.5] },
        "lh-e-b": { "dx": -5.9, "dy": 16, "w": null, "h": null, "radii": [2.5, 2.5, 2.5, 5] },
        "lh-f-c": { "shape": "plate", "dx": 5.9, "dy": 16, "rx": null, "ry": null, "radii": [2.5, 2.5, 5, 2.5] },
        "lh-roller-l": { "default": "open" }, "lh-roller-r": { "default": "open" },
        "rh-ab-eb": { "shape": "plate", "dx": -5.9, "dy": 0, "w": null, "h": null, "stem": null, "radii": [5, 2.5, 2.5, 2.5] },
        "rh-fs-cs": { "shape": "plate", "default": "open", "dx": 5.9, "dy": 0, "w": null, "h": null, "stem": null, "radii": [2.5, 5, 2.5, 2.5] },
        "rh-f-c": { "shape": "plate", "dx": -5.9, "dy": 16, "w": null, "h": null, "stem": null, "radii": [2.5, 2.5, 2.5, 5] },
        "rh-e-b": { "shape": "plate", "dx": 5.9, "dy": 16, "w": null, "h": null, "stem": null, "radii": [2.5, 2.5, 5, 2.5] },
        "rh-roller-l": { "default": "open" }, "rh-roller-r": { "default": "open" },
        "trill-1": { "shape": "pill", "radii": null }, "trill-2": { "shape": "pill", "radii": null },
        "trill-3": { "shape": "pill", "radii": null }, "trill-4": { "shape": "pill", "radii": null }
      }
    },
    "throat-pills": {
      "keys": {
        "throat-a": { "shape": "pill", "w": 13, "h": 6, "x": 30, "y": 20, "rot": -6 },
        "throat-gs": { "shape": "pill", "w": 13, "h": 6, "x": 31, "y": 32, "rot": -6, "kdx": null }
      }
    },
    "ring-keys": {
      "keys": {
        "thumb-hole": { "ringed": true },
        "lh1": { "ringed": true }, "lh2": { "ringed": true }, "lh3": { "ringed": true },
        "rh1": { "ringed": true }, "rh2": { "ringed": true }, "rh3": { "ringed": true }
      }
    }
  },

  "keys": [
    { "id": "register", "label": "Register key (thumb)", "shape": "pin", "w": 7.5, "h": 15, "x": 14, "y": 25, "hand": "L", "digit": "thumb", "group": "rear" },
    { "id": "thumb-hole", "label": "Thumb hole", "shape": "circle", "r": 7, "x": 14, "y": 44, "hand": "L", "digit": "thumb", "group": "rear" },

    { "id": "throat-a", "label": "Throat A", "shape": "pin", "w": 8, "h": 16, "x": 44, "y": 22, "hand": "L", "digit": "1", "group": "throat" },
    { "id": "throat-gs", "label": "Throat G♯", "shape": "pin", "w": 6.5, "h": 18, "kdx": -9, "knob": 2.4, "armLen": 3, "x": 58, "y": 30, "hand": "L", "digit": "1", "group": "throat" },

    { "id": "lh1", "label": "Left 1", "shape": "circle", "x": 44, "y": 44, "hand": "L", "digit": "1", "group": "lh-stack" },
    { "id": "lh2", "label": "Left 2", "shape": "circle", "x": 44, "y": 70, "hand": "L", "digit": "2", "group": "lh-stack" },
    { "id": "lh3", "label": "Left 3", "shape": "circle", "x": 44, "y": 96, "hand": "L", "digit": "3", "group": "lh-stack" },
    { "id": "lh1-eb", "label": "Left side E♭/B♭", "shape": "bean", "w": 4.5, "h": 13, "bend": 0, "dir": "right", "rot": -8, "x": 57, "y": 83, "hand": "L", "digit": "1", "group": "lh-aux" },

    { "id": "trill-1", "label": "Trill 1 (A/B♭)", "cluster": "trill", "hand": "R", "digit": "1", "group": "trill" },
    { "id": "trill-2", "label": "Trill 2", "cluster": "trill", "hand": "R", "digit": "1", "group": "trill" },
    { "id": "trill-3", "label": "Trill 3", "cluster": "trill", "hand": "R", "digit": "1", "group": "trill" },
    { "id": "trill-4", "label": "Trill 4", "cluster": "trill", "hand": "R", "digit": "1", "group": "trill" },

    { "id": "lh-f-c", "label": "LH F/C", "cluster": "lh-table", "shape": "oval", "rx": 7.5, "ry": 3.6, "dx": 2, "dy": 0, "hand": "L", "digit": "4", "group": "lh-table" },
    { "id": "lh-e-b", "label": "LH E/B", "cluster": "lh-table", "shape": "plate", "w": 6.5, "h": 24, "radii": [3.25, 3.25, 1, 1], "dx": -3.5, "dy": 17, "hand": "L", "digit": "4", "group": "lh-table" },
    { "id": "lh-fs-cs", "label": "LH F♯/C♯", "cluster": "lh-table", "shape": "plate", "w": 5.5, "h": 20, "radii": [2.75, 2.75, 1, 1], "dx": 3.5, "dy": 19, "hand": "L", "digit": "4", "group": "lh-table" },
    { "id": "lh-ab-eb", "label": "LH A♭/E♭ (full Boehm)", "cluster": "lh-table", "shape": "plate", "w": 5, "h": 10, "radii": [2.5, 2.5, 1, 1], "dx": 10, "dy": 14, "default": "na", "hand": "L", "digit": "4", "group": "lh-table" },
    { "id": "lh-roller-l", "label": "LH roller (left)", "cluster": "lh-table", "shape": "cylinder", "dx": -5.9, "dy": 8, "w": 3.6, "h": 8.5, "rot": 90, "default": "na", "hand": "L", "digit": "4", "group": "rollers" },
    { "id": "lh-roller-r", "label": "LH roller (right)", "cluster": "lh-table", "shape": "cylinder", "dx": 5.9, "dy": 8, "w": 3.6, "h": 8.5, "rot": 90, "default": "na", "hand": "L", "digit": "4", "group": "rollers" },

    { "id": "rh1", "label": "Right 1", "shape": "circle", "x": 44, "y": 146, "hand": "R", "digit": "1", "group": "rh-stack" },
    { "id": "rh2", "label": "Right 2", "shape": "circle", "x": 44, "y": 172, "hand": "R", "digit": "2", "group": "rh-stack" },
    { "id": "rh3", "label": "Right 3", "shape": "circle", "x": 44, "y": 198, "hand": "R", "digit": "3", "group": "rh-stack" },
    { "id": "rh-side-eb", "label": "Side E♭/B♭ (sliver key)", "shape": "pill", "w": 12, "h": 4, "rad": 2, "rot": 8, "x": 30, "y": 185, "hand": "R", "digit": "1", "group": "rh-aux" },

    { "id": "rh-ab-eb", "label": "RH A♭/E♭", "cluster": "rh-table", "dx": 1, "dy": 0, "stem": 19, "hand": "R", "digit": "4", "group": "rh-table" },
    { "id": "rh-e-b", "label": "RH E/B", "cluster": "rh-table", "dx": -2, "dy": 9, "stem": 10, "hand": "R", "digit": "4", "group": "rh-table" },
    { "id": "rh-f-c", "label": "RH F/C", "cluster": "rh-table", "dx": 0, "dy": 18, "w": 16, "stem": 1, "hand": "R", "digit": "4", "group": "rh-table" },
    { "id": "rh-fs-cs", "label": "RH F♯/C♯", "cluster": "rh-table", "dx": 0, "dy": 0, "default": "na", "hand": "R", "digit": "4", "group": "rh-table" },
    { "id": "rh-roller-l", "label": "RH roller (left)", "cluster": "rh-table", "shape": "cylinder", "dx": -5.9, "dy": 8, "w": 3.6, "h": 8.5, "rot": 90, "default": "na", "hand": "R", "digit": "4", "group": "rollers" },
    { "id": "rh-roller-r", "label": "RH roller (right)", "cluster": "rh-table", "shape": "cylinder", "dx": 5.9, "dy": 8, "w": 3.6, "h": 8.5, "rot": 90, "default": "na", "hand": "R", "digit": "4", "group": "rollers" }
  ]
}
