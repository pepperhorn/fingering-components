{
  "id": "clarinet",
  "name": "Clarinet (B\u266d Boehm, 17-key)",
  "family": "single-reed",
  "transpose": -2,
  "ranges": {
    "beginner":     { "low": "E3", "high": "Bb4" },
    "intermediate": { "low": "E3", "high": "C6" },
    "pro":          { "low": "E3", "high": "A6" }
  },
  "registers": [
    { "from": "E3",   "name": "Low" },
    { "from": "G4",   "name": "Middle" },
    { "from": "B4",   "name": "High" },
    { "from": "C#6",  "name": "Altissimo" }
  ],
  "note": "Front view, facing the instrument (same as the saxophone): left-hand pinky keys on the right at the joint, right-hand pinky keys 2x2 below-right of the stack, trill keys on the left. Thumb hole and register key sit in their own column on the far left.",
  "viewBox": [0, 0, 92, 240],
  "defaults": {
    "circle": {"r": 9},
    "oval": {"rx": 6.5, "ry": 3.8},
    "pill": {"w": 12, "h": 5.5, "rad": 2.75},
    "plate": {"w": 8, "h": 9}
  },
  "panels": [{"id": "front"}],
  "guides": [{"id": "hand-divider", "x1": 34, "y1": 121, "x2": 54, "y2": 121}],

  "clusters": [
    {"id": "trill", "label": "Trill keys", "note": "Four lh-hooks stacked on the left, centred between LH2 and LH3; pressed by the side of the right first finger.", "anchor": [26, 70.85], "defaults": {"shape": "lh-hook", "w": 9.45, "h": 5.4, "stemW": 2.03}},
    {"id": "lh-table", "label": "LH pinky keys", "note": "Right of the stack at the joint: F/C as an rh-hook (lobe right, rod left) on top, E/B and F\u266f/C\u266f below as mirrored paddles (heads up, bellies outward), the inside one a little higher. A\u266d/E\u266d (full Boehm only) is hidden by default.", "anchor": [61, 128]},
    {"id": "rh-table", "label": "RH pinky keys", "note": "Two-by-two below-right of the right-hand stack, each key a lobe with its rod on the right. A\u266d/E\u266d and F\u266f/C\u266f on top (rods run down past the lower keys), F/C and E/B below. Confirm positions against your instrument.", "anchor": [43, 212], "defaults": {"shape": "lh-hook", "h": 8, "stemW": 3}, "rotate": 12}
  ],

  "variants": {
    "throat-pills": {"keys": {"throat-a": {"shape": "pill", "w": 13, "h": 6, "x": 30, "y": 20, "rot": -6}, "throat-gs": {"shape": "pill", "w": 13, "h": 6, "x": 31, "y": 32, "rot": -6}}},
    "ring-keys": {"keys": {"thumb-hole": {"ringed": true}, "lh1": {"ringed": true}, "lh2": {"ringed": true}, "lh3": {"ringed": true}, "rh1": {"ringed": true}, "rh2": {"ringed": true}, "rh3": {"ringed": true}}},
    "pins": {"note": "Register key, throat A and throat G\u266f as pin keys hung from pivot knobs; G\u266f on an arm that crosses from a knob beside throat A.", "keys": {"register": {"shape": "pin", "w": 7, "h": 14, "x": 17, "y": 33, "knob": 2.6, "armLen": 4}, "throat-a": {"shape": "pin", "w": 7, "h": 13, "x": 44, "y": 24, "knob": 2.6, "armLen": 4}, "throat-gs": {"shape": "pin", "w": 5.5, "h": 20, "x": 57, "y": 46, "knob": 2.6, "kdx": -19, "armLen": 15}}}
  },

