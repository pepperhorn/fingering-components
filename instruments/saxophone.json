        "rh-c": { "dx": 0, "dy": 10, "w": 10, "h": 16, "radii": [2, 2, 4, 4] },
        "rh-roller-top": { "dy": -17, "h": 8 },
        "rh-roller-bottom": { "dy": -0.5, "h": 9 }
      }
    },
