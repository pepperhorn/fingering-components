    "palm-taper": {
      "clusters": { "palm": { "anchor": [66, 30], "flow": { "axis": "x", "pitch": 9, "stagger": -7 }, "defaults": { "shape": "taper", "w": 7.5, "h": 24, "tip": 0.8, "bend": 1.4, "curve": 1.7, "tipRound": null } } },
      "keys": { "palm-f": { "rot": -10 }, "palm-eb": { "rot": 2 }, "palm-d": { "rot": 14 } }
    }
  },

  "keys": [
