        "lh-cs": { "h": 10, "w": 8, "dx": 4.25, "dy": 11, "radii": [1.5, 1.5, 1.5, 1.5] },
        "lh-b": { "h": 10, "w": 8, "dx": -4.25, "dy": 11, "radii": [1.5, 1.5, 1.5, 1.5] },
        "lh-bb": { "shape": "dome", "dir": "down", "w": 17, "h": 7, "bend": null, "dy": 20.5 },
        "lh-roller-top": { "default": "na" }, "lh-roller-bottom": { "default": "na" }
