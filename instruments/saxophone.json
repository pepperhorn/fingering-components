    "palm-bean": {
      "clusters": { "palm": { "flow": { "axis": "x", "pitch": 9.5, "stagger": -6 }, "defaults": { "shape": "bean", "w": 8.5, "h": 18, "bend": 1.3, "taper": 0.72, "tipRound": null } } },
