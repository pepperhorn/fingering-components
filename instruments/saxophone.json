{
  "id": "saxophone",
  "name": "Saxophone",
  "family": "single-reed",
  "transposing": true,
  "note": "Layout is written-pitch and identical for soprano/alto/tenor/baritone. Sounding pitch is a property of the horn, not the chart.",
  "viewBox": [0, 0, 106, 236],
  "defaults": {
    "circle": { "r": 9 },
    "oval": { "rx": 6.5, "ry": 3.8 },
    "pill": { "w": 8, "h": 15 },
    "spatula": { "w": 15, "h": 13 },
    "teardrop": { "w": 11, "h": 20 }
  },
  "panels": [{ "id": "front" }],
  "guides": [{ "id": "hand-divider", "x1": 31, "y1": 125, "x2": 50, "y2": 125 }],

  "clusters": [
    {
      "id": "palm",
      "label": "Palm keys",
      "anchor": [68, 33],
      "rotate": -4,
      "flow": { "axis": "x", "pitch": 10, "stagger": -8 },
      "defaults": { "shape": "teardrop", "w": 10, "h": 19, "dir": "up", "tipRound": 2 }
    },
    {
      "id": "side",
      "label": "Side keys",
      "note": "Top to bottom: high E (C3), side C (Tc), side B\u266d (Ta), west of the right-hand stack.",
      "anchor": [21, 108],
      "rotate": 0,
      "flow": { "axis": "y", "pitch": 17 },
      "defaults": { "shape": "bean", "w": 6.5, "h": 15, "bend": 0, "taper": 0.85 }
    },
    {
      "id": "lh-table",
      "label": "LH pinky table",
      "note": "East of the stack, straddling the LH/RH divider. One table: a short, wide G\u266f on top, tall B | C\u266f side by side, and a curved B\u266d wrapping underneath.",
      "anchor": [67, 104],
      "rotate": 0,
      "defaults": { "shape": "plate", "w": 20, "h": 16 }
    },
    {
      "id": "rh-table",
      "label": "RH pinky keys",
      "note": "The LH B | C\u266f pair turned 90\u00b0: D\u266f (low E\u266d) above low C, rollers between them at each end, at seven o'clock of the right-hand stack.",
      "anchor": [21, 208],
      "rotate": 82,
      "defaults": { "shape": "plate", "w": 7.5, "h": 20, "radii": [3, 3, 3.5, 3.5] }
    }
  ],

  "variants": {
