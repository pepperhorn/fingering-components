    { "id": "rh-c", "label": "Low C", "cluster": "rh-table", "dx": 6.79, "dy": 0, "w": 9.43, "h": 14.49, "radii": [2.3, 2.3, 4.02, 4.02], "hand": "R", "digit": "4", "group": "rh-table" },
    { "id": "rh-roller-top", "label": "RH roller (D\u266f | C, one end)", "cluster": "rh-table", "shape": "cylinder", "dx": 0, "dy": -5.63, "w": 3.91, "h": 8.05, "rot": 90, "radii": null, "hand": "R", "digit": "4", "group": "rollers" },
