{
  "id": "saxophone",
  "name": "Saxophone",
  "family": "single-reed",
  "transpose": -9,
  "ranges": {
    "beginner":     { "low": "Bb3", "high": "C6" },
    "intermediate": { "low": "Bb3", "high": "F6" },
    "pro":          { "low": "Bb3", "high": "F7" }
  },
  "registers": [
    { "from": "Bb3",  "name": "Low" },
    { "from": "D4",   "name": "Middle" },
    { "from": "D5",   "name": "High" },
    { "from": "G6",   "name": "Altissimo" }
  ],
  "horn": "alto",
  "horns": { "soprano": { "name": "B\u266d soprano", "transpose": -2 }, "alto": { "name": "E\u266d alto", "transpose": -9 }, "tenor": { "name": "B\u266d tenor", "transpose": -14 }, "baritone": { "name": "E\u266d baritone", "transpose": -21 } },
  "note": "Layout is written-pitch and identical for soprano/alto/tenor/baritone. Sounding pitch is a property of the horn, not the chart.",
  "viewBox": [0, 0, 106, 236],
  "defaults": {
    "circle": { "r": 9 },
    "oval": { "rx": 6.5, "ry": 3.8 },
    "pill": { "w": 8, "h": 15 },
    "spatula": { "w": 15, "h": 13 },
    "teardrop": { "w": 11, "h": 20 }
  },
  "panels": [{ "id": "front" }],
  "guides": [{ "id": "hand-divider", "x1": 31, "y1": 125, "x2": 50, "y2": 125 }],

  "clusters": [
    {
      "id": "palm",
      "label": "Palm keys",
      "anchor": [72, 30],
      "rotate": 0,
      "defaults": { "shape": "leaf", "w": 8.5, "h": 21, "end": 0.45, "bend": 1 }
    },
    {
      "id": "side",
      "label": "Side keys",
      "note": "Top to bottom: high E (C3), side C (Tc), side B\u266d (Ta), west of the right-hand stack.",
      "anchor": [21, 108],
      "rotate": 0,
      "flow": { "axis": "y", "pitch": 17 },
      "defaults": { "shape": "bean", "w": 6.5, "h": 15, "bend": 0, "taper": 0.85 }
    },
    {
      "id": "lh-table",
      "label": "LH pinky table",
      "note": "East of the stack, straddling the LH/RH divider. One table: a short, wide G\u266f on top, tall B | C\u266f side by side, and a curved B\u266d wrapping underneath.",
      "anchor": [67, 104],
      "rotate": 0,
      "defaults": { "shape": "plate", "w": 20, "h": 16 }
    },
    {
      "id": "rh-table",
      "label": "RH pinky keys",
      "note": "Default look is the split circle: D\u266f (low E\u266d) and low C as two domes base-to-base, at seven o'clock of the right-hand stack. The cluster defaults stay `plate` so `rh-table-stacked` keeps inheriting a plate; the dome is set per key.",
      "anchor": [20, 210],
      "rotate": 0,
      "defaults": { "shape": "plate", "w": 7.5, "h": 20, "radii": [3, 3, 3.5, 3.5] }
    }
  ],

  "variants": {
    "palm-teardrop": {
      "clusters": { "palm": { "anchor": [68, 33], "rotate": -4, "flow": { "axis": "x", "pitch": 10, "stagger": -8 }, "defaults": { "shape": "teardrop", "w": 10, "h": 19, "dir": "up", "tipRound": 2, "end": null, "bend": null } } },
      "keys": { "palm-f": { "dx": null, "dy": null, "rot": null }, "palm-eb": { "dx": null, "dy": null, "rot": null }, "palm-d": { "dx": null, "dy": null, "rot": null } }
    },
    "rh-table-stacked": {
      "note": "`shape`/`dir`/`default` are restated here because the base rh-table keys are now domes with the rollers off; without them this variant would silently inherit the dome look.",
      "clusters": { "rh-table": { "anchor": [13, 206], "rotate": -6 } },
      "keys": {
        "rh-eb": { "shape": "plate", "dx": 0, "dy": -9, "w": 9, "h": 12, "radii": [3, 3, 2, 2] },
        "rh-c": { "shape": "plate", "dir": null, "dx": 0, "dy": 10, "w": 10, "h": 16, "radii": [2, 2, 4, 4] },
        "rh-roller-top": { "dy": -17, "h": 8, "default": "open" },
        "rh-roller-bottom": { "dy": -0.5, "h": 9, "default": "open" }
      }
    },
    "lh-table-domes": {
      "keys": {
        "lh-gs": { "shape": "dome", "h": 7, "w": 17, "dy": 1.5, "radii": null },
        "lh-cs": { "h": 10, "w": 8, "dx": 4.25, "dy": 11, "radii": [1.5, 1.5, 1.5, 1.5] },
        "lh-b": { "h": 10, "w": 8, "dx": -4.25, "dy": 11, "radii": [1.5, 1.5, 1.5, 1.5] },
        "lh-bb": { "shape": "dome", "dir": "down", "w": 17, "h": 7, "bend": null, "dy": 20.5 },
        "lh-roller-top": { "default": "na" }, "lh-roller-bottom": { "default": "na" }
      }
    },
    "rh-table-domes": {
      "note": "Now a no-op: this geometry is the base rh-table. Kept so saved boards that name the variant still validate and render identically.",
      "clusters": { "rh-table": { "anchor": [20, 210], "rotate": 0 } },
      "keys": {
        "rh-eb": { "shape": "dome", "w": 17, "h": 8, "dx": 0, "dy": -4.8, "radii": null },
        "rh-c": { "shape": "dome", "dir": "down", "w": 17, "h": 8, "dx": 0, "dy": 4.8, "radii": null },
        "rh-roller-top": { "default": "na" }, "rh-roller-bottom": { "default": "na" }
      }
    },
    "side-levers": {
      "clusters": { "side": { "anchor": [14, 108], "defaults": { "shape": "lever", "size": "lg", "stemDir": "right", "w": null, "h": null, "bend": null, "taper": null } } }
    },
    "side-pills": {
      "clusters": { "side": { "anchor": [18, 113], "flow": { "axis": "y", "pitch": 12 }, "defaults": { "shape": "pill", "w": 15, "h": 6.5, "rad": 3.2, "bend": null, "taper": null } } }
    },
    "high-fs-single": {
      "keys": { "high-fs": { "y": 180 }, "high-g": { "default": "na" } }
    },
    "rh-table-spatulas": {
      "note": "`shape`/`dir` are restated here because the base rh-table keys are now domes; without them this variant would silently inherit the dome look.",
      "clusters": { "rh-table": { "anchor": [24, 224], "rotate": 9, "flow": { "axis": "x", "pitch": 18 }, "defaults": { "shape": "spatula", "w": 16, "h": 14, "rad": 5, "radii": null } } },
      "keys": { "rh-eb": { "shape": "spatula", "dx": null, "dy": null, "w": null, "h": null }, "rh-c": { "shape": "spatula", "dir": null, "dx": null, "dy": null, "w": null, "h": null }, "rh-roller-top": { "default": "na" }, "rh-roller-bottom": { "default": "na" } }
    },
    "lh-table-spatulas": {
      "clusters": { "lh-table": { "anchor": [66, 100], "flow": { "axis": "y", "pitch": 15, "drift": 1 }, "defaults": { "shape": "spatula", "w": 14, "h": 12, "rad": 4.5 } } },
      "keys": {
        "lh-gs": { "dx": null, "dy": null, "h": null, "radii": null },
        "lh-cs": { "dx": null, "dy": null, "w": null, "h": null, "radii": null },
        "lh-b": { "dx": null, "dy": null, "w": null, "h": null, "radii": null, "ddx": -1.5 },
        "lh-bb": { "shape": "spatula", "dx": null, "dy": null, "w": null, "h": null, "bend": null, "dir": null, "ddx": -3 },
        "lh-roller-top": { "default": "na" }, "lh-roller-bottom": { "default": "na" }
      }
    },
    "palm-bean": {
      "clusters": { "palm": { "flow": { "axis": "x", "pitch": 12, "stagger": -6 }, "defaults": { "shape": "bean", "w": 8.5, "h": 18, "bend": 1.3, "taper": 0.72, "tipRound": null } } },
      "keys": { "palm-f": { "dx": null, "dy": null, "rot": -8 }, "palm-eb": { "dx": null, "dy": null, "rot": 6 }, "palm-d": { "dx": null, "dy": null, "rot": 20 } }
    },
    "plain-circles": {
      "note": "Main stack and front F as plain circles instead of top-down saucers.",
      "keys": { "lh1": { "shape": "circle", "size": null }, "lh2": { "shape": "circle", "size": null }, "lh3": { "shape": "circle", "size": null }, "rh1": { "shape": "circle", "size": null }, "rh2": { "shape": "circle", "size": null }, "rh3": { "shape": "circle", "size": null }, "front-f": { "shape": "circle", "size": null, "r": 5 } }
    },
    "palm-taper": {
      "clusters": { "palm": { "anchor": [66, 30], "flow": { "axis": "x", "pitch": 11, "stagger": -7 }, "defaults": { "shape": "taper", "w": 7.5, "h": 24, "tip": 0.8, "bend": 1.4, "curve": 1.7, "tipRound": null } } },
      "keys": { "palm-f": { "dx": null, "dy": null, "rot": -10 }, "palm-eb": { "dx": null, "dy": null, "rot": 2 }, "palm-d": { "dx": null, "dy": null, "rot": 14 } }
    }
  },

  "keys": [
    { "id": "thumb-rest", "label": "Left thumb rest", "shape": "circle", "r": 6.5, "x": 15, "y": 33, "hand": "L", "digit": "thumb", "group": "octave" },
    { "id": "octave", "label": "Octave key (thumb)", "shape": "bean", "w": 6, "h": 14, "bend": -0.6, "dir": "right", "x": 15, "y": 20.5, "hand": "L", "digit": "thumb", "group": "octave" },

    { "id": "front-f", "label": "Front F", "shape": "saucer-top", "size": "sm", "relativeTo": "lh1", "place": "above", "gap": 8, "hand": "L", "digit": "1", "group": "lh-aux" },

    { "id": "lh1", "label": "Left 1 (B)", "shape": "saucer-top", "size": "md", "x": 41, "y": 44, "hand": "L", "digit": "1", "group": "lh-stack" },
    { "id": "lh2", "label": "Left 2 (A)", "shape": "saucer-top", "size": "md", "relativeTo": "lh1", "place": "below", "gap": 10, "hand": "L", "digit": "2", "group": "lh-stack" },
    { "id": "lh3", "label": "Left 3 (G)", "shape": "saucer-top", "size": "md", "relativeTo": "lh2", "place": "below", "gap": 10, "hand": "L", "digit": "3", "group": "lh-stack" },

    { "id": "bis", "label": "Bis B\u266d", "shape": "oval", "relativeTo": "lh1", "place": "below", "gap": 0, "offset": [16, 0], "hand": "L", "digit": "1", "group": "lh-aux" },

    { "id": "palm-d", "label": "Palm D (C1)", "cluster": "palm", "index": 2, "dx": 10.5, "dy": 0, "rot": 12, "hand": "L", "digit": "palm", "group": "palm" },
    { "id": "palm-eb", "label": "Palm E\u266d (C2)", "cluster": "palm", "index": 1, "dx": -1, "dy": -12.5, "rot": 12, "hand": "L", "digit": "palm", "group": "palm" },
    { "id": "palm-f", "label": "Palm F (C4)", "cluster": "palm", "index": 0, "dx": 0, "dy": 13.5, "rot": 12, "hand": "L", "digit": "palm", "group": "palm" },

    { "id": "side-bb", "label": "Side B\u266d (Ta)", "cluster": "side", "index": 2, "hand": "R", "digit": "1", "group": "side" },
    { "id": "side-c", "label": "Side C (Tc)", "cluster": "side", "index": 1, "hand": "R", "digit": "1", "group": "side" },
    { "id": "side-e", "label": "Side E (high E, C3)", "cluster": "side", "index": 0, "hand": "R", "digit": "1", "group": "side" },
    { "id": "high-fs", "label": "High F\u266f (C5)", "shape": "bean", "w": 5.5, "h": 10, "bend": 0, "x": 22, "y": 175, "hand": "R", "digit": "1", "group": "side" },
    { "id": "high-g", "label": "High G (pro horns)", "shape": "bean", "w": 5.5, "h": 10, "bend": 0, "x": 22, "y": 186.5, "hand": "R", "digit": "1", "group": "side" },

    { "id": "lh-gs", "label": "G\u266f", "cluster": "lh-table", "dx": 0, "dy": 0, "h": 9.5, "radii": [4.75, 4.75, 3, 3], "hand": "L", "digit": "4", "group": "lh-table" },
    { "id": "lh-cs", "label": "Low C\u266f", "cluster": "lh-table", "dx": 5.9, "dy": 12.8, "w": 8.2, "h": 12.6, "radii": [2, 2, 3.5, 3.5], "hand": "L", "digit": "4", "group": "lh-table" },
    { "id": "lh-b", "label": "Low B", "cluster": "lh-table", "dx": -5.9, "dy": 12.8, "w": 8.2, "h": 12.6, "radii": [2, 2, 3.5, 3.5], "hand": "L", "digit": "4", "group": "lh-table" },
    { "id": "lh-roller-top", "label": "LH roller (upper, B | C\u266f)", "cluster": "lh-table", "shape": "cylinder", "dx": 0, "dy": 7.9, "w": 3.4, "h": 7, "rot": 90, "radii": null, "hand": "L", "digit": "4", "group": "rollers" },
    { "id": "lh-roller-bottom", "label": "LH roller (lower, B | C\u266f)", "cluster": "lh-table", "shape": "cylinder", "dx": 0, "dy": 17.7, "w": 3.4, "h": 7, "rot": 90, "radii": null, "hand": "L", "digit": "4", "group": "rollers" },
    { "id": "lh-bb", "label": "Low B\u266d", "cluster": "lh-table", "shape": "bean", "dx": 0, "dy": 26, "w": 8.5, "h": 23, "bend": 1.6, "dir": "right", "hand": "L", "digit": "4", "group": "lh-table" },

    { "id": "rh1", "label": "Right 1 (F)", "shape": "saucer-top", "size": "md", "x": 41, "y": 150, "hand": "R", "digit": "1", "group": "rh-stack" },
    { "id": "rh2", "label": "Right 2 (E)", "shape": "saucer-top", "size": "md", "relativeTo": "rh1", "place": "below", "gap": 10, "hand": "R", "digit": "2", "group": "rh-stack" },
    { "id": "rh3", "label": "Right 3 (D)", "shape": "saucer-top", "size": "md", "relativeTo": "rh2", "place": "below", "gap": 10, "hand": "R", "digit": "3", "group": "rh-stack" },

    { "id": "alt-fs", "label": "Alternate F\u266f", "shape": "oval", "x": 25, "y": 164, "hand": "R", "digit": "3", "group": "rh-aux" },

    { "id": "rh-eb", "label": "Low E\u266d (D\u266f)", "cluster": "rh-table", "shape": "dome", "dx": 0, "dy": -4.8, "w": 17, "h": 8, "radii": null, "hand": "R", "digit": "4", "group": "rh-table" },
    { "id": "rh-c", "label": "Low C", "cluster": "rh-table", "shape": "dome", "dir": "down", "dx": 0, "dy": 4.8, "w": 17, "h": 8, "radii": null, "hand": "R", "digit": "4", "group": "rh-table" },
    { "id": "rh-roller-top", "label": "RH roller (D\u266f | C, one end)", "cluster": "rh-table", "shape": "cylinder", "dx": 0, "dy": -5.63, "w": 3.91, "h": 8.05, "rot": 90, "radii": null, "default": "na", "hand": "R", "digit": "4", "group": "rollers" },
    { "id": "rh-roller-bottom", "label": "RH roller (D\u266f | C, other end)", "cluster": "rh-table", "shape": "cylinder", "dx": 0, "dy": 5.63, "w": 3.91, "h": 8.05, "rot": 90, "radii": null, "default": "na", "hand": "R", "digit": "4", "group": "rollers" }
  ]
}
