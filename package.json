{
  "name": "fingering-components",
  "version": "0.1.0",
  "description": "SVG key shapes and a JSON spec for woodwind and brass fingering charts",
  "type": "module",
  "main": "src/render.js",
  "exports": {
    ".": "./src/render.js",
    "./keys": "./src/keys.js",
    "./layout": "./src/layout.js",
    "./react": "./src/react.jsx",
    "./instruments/*": "./instruments/*.json",
    "./fingerings/*": "./fingerings/*.json"
  },
  "files": ["src", "instruments", "fingerings", "README.md", "LICENSE"],
  "scripts": {
    "verify": "node verify.mjs",
    "preview": "node build-preview.mjs",
    "prepublishOnly": "node verify.mjs"
  },
  "keywords": ["fingering-chart", "saxophone", "clarinet", "flute", "recorder", "tin-whistle", "music-education", "svg"],
  "license": "MIT",
  "sideEffects": false
}
